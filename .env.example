# GitRoast Environment Variables
# Server Port (default 8080 for Cloud Run compatibility)
PORT=8080

# Optional: GitHub Personal Access Token to raise rate limit from 60 req/hr to 5,000 req/hr
# GITHUB_TOKEN=ghp_yourPersonalAccessTokenHere

# Optional: OpenAI API Key for dynamic natural language roasts (rule-based fallback runs automatically if omitted)
# OPENAI_API_KEY=sk-yourOpenAIKeyHere
# OPENAI_MODEL=gpt-4o-mini

# Cache Time-To-Live in seconds (default 900 = 15 minutes)
CACHE_TTL_SECONDS=900
